{
  "name": "peripherals-hub",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.cjs",
  "scripts": {
    "list-hid": "tsx scripts/list-hid.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx drivers/mad60he/protocol/test-codec.ts && tsx drivers/mad60he/protocol/test-transmitter.ts",
    "import-profile": "tsx scripts/import-capture.ts",
    "build:drivers": "esbuild drivers/mad60he/index.ts --bundle --platform=node --format=esm --outfile=drivers/mad60he/index.js --external:node-hid && esbuild drivers/ajazz-aj159-pro/index.ts --bundle --platform=node --format=esm --outfile=drivers/ajazz-aj159-pro/index.js --external:node-hid",
    "build:renderer": "vite build",
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --outfile=dist/main/index.cjs --external:electron --external:node-hid && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.cjs --external:electron",
    "build": "pnpm build:drivers && pnpm build:renderer && pnpm build:electron",
    "start": "node scripts/launch-electron.cjs dist/main/index.cjs",
    "dev:renderer": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.cjs dist/main/index.cjs",
    "rebuild:node-hid": "electron-rebuild -f -w node-hid"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.77.0",
    "node-hid": "^3.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-hid",
      "esbuild",
      "electron"
    ]
  }
}
